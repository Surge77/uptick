# ─────────────────────────────────────────────────────────────
# Uptick environment variables
# Copy to .env.local and fill in. NEVER commit .env.local
# ─────────────────────────────────────────────────────────────

# ── Database (Neon or any PostgreSQL) ────────────────────────
# Pooled connection, used by the application at runtime
DATABASE_URL=
# Direct (non-pooled) connection, required by Prisma migrations
DIRECT_URL=

# ── Auth (Phase 7) ───────────────────────────────────────────
# Generate with: openssl rand -base64 32
AUTH_SECRET=
AUTH_GITHUB_ID=
AUTH_GITHUB_SECRET=
# Public origin of the web app, e.g. http://localhost:3000
AUTH_URL=
NEXT_PUBLIC_APP_URL=

# ── Worker (Phase 4) ─────────────────────────────────────────
# Must match a Region.slug row: fra | iad | sin | local
REGION=local
# Scheduler tick interval in milliseconds
WATCH_TICK_MS=10000
# Max concurrent in-flight probes per worker
WATCH_CONCURRENCY=50
# Monitors claimed per tick
WATCH_BATCH_SIZE=200

# ── Alerting (Phase 6) ───────────────────────────────────────
RESEND_API_KEY=
ALERT_FROM_EMAIL=

# ── Rate limiting (Phase 10, optional) ───────────────────────
# Without these, an in-memory per-instance limiter is used
UPSTASH_REDIS_REST_URL=
UPSTASH_REDIS_REST_TOKEN=

# ── Deploy correlation webhooks (Phase 9, optional) ──────────
# Shared secret used to verify inbound deploy webhooks
DEPLOY_WEBHOOK_SECRET=
